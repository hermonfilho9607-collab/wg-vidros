# Cabecalhos de seguranca e cache.
# Lido automaticamente por Netlify e Cloudflare Pages. Nao precisa configurar nada.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'none'; upgrade-insecure-requests

# HTML: sempre revalida, para uma correcao no texto aparecer na hora
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Imagens, fonte e CSS: nome fixo, entao cache de um dia
/assets/*
  Cache-Control: public, max-age=86400
